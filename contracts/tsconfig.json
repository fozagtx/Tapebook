{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["es2022"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "mocha", "chai", "chai-as-promised"]
  },
  "include": ["hardhat.config.ts", "scripts", "test", "circuits", "abi", "core", "artifacts/**/*.d.ts"]
}
