# Copy to .env.local (or set in Vercel). Addresses come from contracts/deployments/196.json.
NEXT_PUBLIC_CLAIMS_ADDRESS=
NEXT_PUBLIC_TAPEBOOK_CIRCUITS=
NEXT_PUBLIC_TAPEBOOK_TRANSISTORS=
# Optional: block the TapeOut factory proxy was deployed at (bounds the version watcher's log scan).
NEXT_PUBLIC_TAPEOUT_DEPLOY_BLOCK=
# WalletConnect (mobile wallets). Without it only browser-extension wallets are offered.
NEXT_PUBLIC_WC_PROJECT_ID=
# Server-side RPC override for /api/index and /api/versions.
XLAYER_RPC_URL=
